# Шаблон: ./deploy.sh --nginx --domain example.ru рендерит его через envsubst
# в /etc/nginx/sites-available/dotdot. Правьте шаблон, а не установленный файл:
# деплой перезапишет установленный. TLS добавляет certbot поверх (--nginx после
# certbot откажется затирать конфиг и положит рядом .candidate для ручного сравнения).

upstream dotdot_api {
    server 127.0.0.1:${PORT};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # API режет файлы по MAX_UPLOAD_MB; +1 МБ отсекает лишнее на краю
    client_max_body_size ${BODY_LIMIT};

    location /api/ {
        # без URI в конце proxy_pass: префикс /api сохраняется (global prefix NestJS)
        proxy_pass http://dotdot_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # SSE /api/jobs/:id/events: иначе статусы приедут одним куском в конце
        proxy_buffering off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    root ${APP_DIR}/apps/web/dist;
    index index.html;

    # add_header не наследуется с уровня server, если в location есть свой — дублируем
    # хешированные бандлы не меняются — можно кешировать навсегда
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Content-Type-Options nosniff always;
    }

    # index.html перевалидируется: деплой виден сразу; неизвестные пути — SPA
    location / {
        add_header Cache-Control "no-cache";
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri $uri/ /index.html;
    }
}