# Скопируйте в корень клона: cp deploy/pm2/env.example .env && chmod 600 .env
#
# Файл читают два загрузчика: node --env-file (API) и bash source (воркер).
# Bash строже, поэтому: комментарии только отдельными строками, без пробелов вокруг "=",
# значения с & или пробелами — в двойных кавычках, значения с $ — в одинарных.
# deploy.sh проверяет формат и не даст задеплоить файл, который bash прочитает иначе.
#
# Переменные docker-compose (DOMAIN, EMAIL, *_REPLICAS) здесь не нужны:
# домен задаётся в nginx, число процессов — в deploy/pm2/ecosystem.config.cjs.

REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=dots
QUEUE_PREFIX=dotdot
STORAGE_DIR=/var/data/dotdot

# Единственный источник порта: и для API, и для nginx-шаблона. deploy.sh требует,
# чтобы PORT был задан здесь, а pm2 берёт его из этого файла при каждом запуске.
PORT=3000
# API слушает только loopback: nginx на этой же машине. 0.0.0.0 нужен, только если
# к API обращаются с другой машины — тогда порт обязан быть закрыт ufw.
# BIND=127.0.0.1
# 1 = один nginx впереди; 2 = Cloudflare -> nginx
TRUST_PROXY=1
MAX_UPLOAD_MB=10
# задачи очереди, не загрузки: одна загрузка = анализ + до 5 вариантов, т.е. 300 ≈ 50 загрузок
MAX_WAITING_JOBS=300
RESULT_TTL_SEC=86400
JOB_ATTEMPTS=2
RATE_CREATE_PER_MIN=10
RATE_CREATE_PER_HOUR=60
RATE_READ_PER_MIN=300

WORKER_CONCURRENCY=1
JOB_TIMEOUT_SEC=60
LOG_LEVEL=INFO

DONATE_CLOUDTIPS_URL=
DONATE_BOOSTY_URL=
DONATE_KOFI_URL=