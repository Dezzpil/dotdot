# copy to .env and adjust
DOMAIN=dotdot.example.com
EMAIL=you@example.com

API_REPLICAS=2
WORKER_REPLICAS=2          # ~1 CPU core each; rule of thumb: cores - 1

# 1 = Caddy only; 2 = Cloudflare -> Caddy
TRUST_PROXY=1

MAX_UPLOAD_MB=10
MAX_WAITING_JOBS=300       # above this new uploads get a friendly "busy, try in a minute"
RESULT_TTL_SEC=86400       # uploads and results are deleted after 24 h
RATE_CREATE_PER_MIN=10
RATE_CREATE_PER_HOUR=60
RATE_READ_PER_MIN=300

DONATE_CLOUDTIPS_URL=
DONATE_BOOSTY_URL=
DONATE_KOFI_URL=
