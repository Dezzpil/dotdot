{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# hashed bundles never change
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# everything else (index.html for any route, favicon) is revalidated: deploys show up at once
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	# single-page app: unknown paths get index.html
	try_files {path} /index.html
	file_server
}
